{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run format)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git pull)",
      "Bash(git fetch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Read(./src/**)",
      "Read(./supabase/**)",
      "Read(./public/**)",
      "Edit(./src/**)",
      "Edit(./supabase/**)",
      "Edit(./public/**)",
      "Write(./src/**)",
      "Write(./supabase/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --amend*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./AGENTS.md)",
      "Edit(./bunfig.toml)",
      "Edit(./.lovable/**)",
      "Write(./.lovable/**)"
    ]
  }
}
